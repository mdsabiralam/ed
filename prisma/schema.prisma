// =========================================================================
// 13. MODULE 02 MODELS (STUDENT ADMISSION & LEAD MANAGEMENT)
// =========================================================================

model AdmissionSession {
  id                String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId       String                 @map("institute_id") @db.Uuid
  academicSessionId String                 @map("academic_session_id") @db.Uuid
  name              String                 @db.VarChar(100)
  startDate         DateTime               @map("start_date") @db.Date
  endDate           DateTime               @map("end_date") @db.Date
  status            AdmissionSessionStatus @default(DRAFT)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime?              @map("deleted_at")
  deletedBy         String?                @map("deleted_by") @db.Uuid

  institute       Institute       @relation("InstituteToAdmissionSessions", fields: [instituteId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation("AcademicSessionToAdmissionSessions", fields: [academicSessionId], references: [id], onDelete: Cascade)
  leads           Lead[]          @relation("AdmissionSessionToLeads")
  applications    AdmissionApplication[] @relation("AdmissionSessionToApplications")

  @@index([instituteId])
  @@index([academicSessionId])
  @@map("admission_sessions")
}

model Lead {
  id                 String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId        String      @map("institute_id") @db.Uuid
  branchId           String?     @map("branch_id") @db.Uuid
  admissionSessionId String      @map("admission_session_id") @db.Uuid
  firstName          String      @map("first_name") @db.VarChar(100)
  lastName           String      @map("last_name") @db.VarChar(100)
  email              String?     @db.VarChar(255)
  phone              String?     @db.VarChar(50)
  className          String?     @map("class_name") @db.VarChar(100)
  status             LeadStatus  @default(NEW)
  source             String?     @default("WEBSITE") @db.VarChar(100)
  notes              String?
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?   @map("deleted_at")
  deletedBy          String?     @map("deleted_by") @db.Uuid

  institute        Institute        @relation("InstituteToLeads", fields: [instituteId], references: [id], onDelete: Cascade)
  branch           Branch?          @relation("BranchToLeads", fields: [branchId], references: [id], onDelete: SetNull)
  admissionSession AdmissionSession @relation("AdmissionSessionToLeads", fields: [admissionSessionId], references: [id], onDelete: Cascade)
  applications     AdmissionApplication[] @relation("LeadToApplications")
  followups        LeadFollowup[]   @relation("LeadToFollowups")

  @@index([instituteId])
  @@index([branchId])
  @@index([admissionSessionId])
  @@index([status])
  // Compound SaaS indexes
  @@index([instituteId, status], map: "idx_leads_inst_status")
  @@index([instituteId, admissionSessionId], map: "idx_leads_inst_session")
  @@map("leads")
}

model LeadFollowup {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId      String    @map("institute_id") @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  followedUpBy     String    @map("followed_up_by") @db.Uuid
  followUpDate     DateTime  @default(now()) @map("follow_up_date")
  nextFollowUpDate DateTime? @map("next_follow_up_date")
  mode             String    @default("CALL") @db.VarChar(50)
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  institute   Institute @relation("InstituteToLeadFollowups", fields: [instituteId], references: [id], onDelete: Cascade)
  lead        Lead      @relation("LeadToFollowups", fields: [leadId], references: [id], onDelete: Cascade)
  staff       User      @relation("UserToLeadFollowups", fields: [followedUpBy], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([followedUpBy])
  // Compound indexes
  @@index([instituteId, leadId], map: "idx_lead_followups_inst_lead")
  @@map("lead_followups")
}

model AdmissionFormTemplate {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId   String    @map("institute_id") @db.Uuid
  name          String    @db.VarChar(100)
  className     String    @map("class_name") @db.VarChar(100)
  isActive      Boolean   @default(true) @map("is_active")
  version       Int       @default(1)
  formFieldsJson Json     @map("form_fields_json")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by") @db.Uuid

  institute Institute @relation("InstituteToAdmissionFormTemplates", fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, className])
  @@map("admission_form_templates")
}

model AdmissionApplication {
  id                 String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId        String            @map("institute_id") @db.Uuid
  branchId           String            @map("branch_id") @db.Uuid
  leadId             String?           @map("lead_id") @db.Uuid
  admissionSessionId String            @map("admission_session_id") @db.Uuid
  applicationNumber  String            @unique @map("application_number") @db.VarChar(100)
  firstName          String            @map("first_name") @db.VarChar(100)
  lastName           String            @map("last_name") @db.VarChar(100)
  email              String?           @db.VarChar(255)
  phone              String?           @db.VarChar(50)
  dateOfBirth        DateTime          @map("date_of_birth") @db.Date
  gender             String?           @db.VarChar(50)
  className          String            @map("class_name") @db.VarChar(100)
  sectionName        String?           @map("section_name") @db.VarChar(100)
  guardianFirstName  String            @map("guardian_first_name") @db.VarChar(100)
  guardianLastName   String            @map("guardian_last_name") @db.VarChar(100)
  guardianEmail      String            @map("guardian_email") @db.VarChar(255)
  guardianPhone      String            @map("guardian_phone") @db.VarChar(50)
  guardianRelation   String            @map("guardian_relation") @db.VarChar(50)
  guardianOccupation String?           @map("guardian_occupation") @db.VarChar(150)
  guardianId         String?           @map("guardian_id") @db.Uuid
  status             ApplicationStatus @default(SUBMITTED)
  waitlistNumber     Int?              @map("waitlist_number")
  isReserved         Boolean           @default(false) @map("is_reserved")
  customFieldsJson   Json?             @map("custom_fields_json")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  deletedBy          String?           @map("deleted_by") @db.Uuid

  institute        Institute         @relation("InstituteToAdmissionApplications", fields: [instituteId], references: [id], onDelete: Cascade)
  branch           Branch            @relation("BranchToAdmissionApplications", fields: [branchId], references: [id], onDelete: Cascade)
  lead             Lead?             @relation("LeadToApplications", fields: [leadId], references: [id], onDelete: SetNull)
  admissionSession AdmissionSession  @relation("AdmissionSessionToApplications", fields: [admissionSessionId], references: [id], onDelete: Cascade)
  guardian         Guardian?         @relation("GuardianToAdmissionApplications", fields: [guardianId], references: [id], onDelete: SetNull)
  documents        AdmissionDocument[] @relation("ApplicationToDocuments")
  entranceExam     EntranceExam?     @relation("ApplicationToEntranceExam")
  interview        AdmissionInterview? @relation("ApplicationToInterview")
  approvalLogs     AdmissionApprovalLog[] @relation("ApplicationToApprovalLogs")
  ocrJobs          OCRAdmissionJob[]  @relation("ApplicationToOcrJobs")

  @@index([instituteId])
  @@index([branchId])
  @@index([admissionSessionId])
  @@index([guardianId])
  @@index([status])
  // Compound SaaS indexes
  @@index([instituteId, status], map: "idx_applications_inst_status")
  @@index([instituteId, className], map: "idx_applications_inst_class")
  @@index([instituteId, admissionSessionId], map: "idx_applications_inst_session")
  @@map("admission_applications")
}

model AdmissionDocument {
  id                 String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId        String                     @map("institute_id") @db.Uuid
  applicationId      String                     @map("application_id") @db.Uuid
  documentType       DocumentType               @map("document_type")
  fileUrl            String                     @map("file_url")
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  rejectedReason     String?                    @map("rejected_reason")
  verifiedBy         String?                    @map("verified_by") @db.Uuid
  verifiedAt         DateTime?                  @map("verified_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?                  @map("deleted_at")
  deletedBy          String?                    @map("deleted_by") @db.Uuid

  institute   Institute            @relation("InstituteToAdmissionDocuments", fields: [instituteId], references: [id], onDelete: Cascade)
  application AdmissionApplication @relation("ApplicationToDocuments", fields: [applicationId], references: [id], onDelete: Cascade)
  verifier    User?                @relation("UserToVerifiedDocuments", fields: [verifiedBy], references: [id], onDelete: SetNull)
  ocrJobs     OCRAdmissionJob[]    @relation("DocumentToOcrJobs")

  @@index([instituteId])
  @@index([applicationId])
  // Compound SaaS indexes
  @@index([instituteId, verificationStatus], map: "idx_documents_inst_status")
  @@map("admission_documents")
}

model EntranceExam {

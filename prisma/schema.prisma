// Prisma Schema: schema.prisma
// Database type: PostgreSQL (Supabase)
// System Version: v6.2 Enterprise Foundation & Module 02 Patched Mapping

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// 1. BILLING & SAAS PLANS
// =========================================================================

model Plan {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String    @unique @db.VarChar(100)
  price        Decimal   @db.Decimal(10, 2)
  billingCycle String    @map("billing_cycle") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Uuid

  institutes    Institute[]
  planFeatures  PlanFeature[]
  subscriptions InstituteSubscription[]

  @@map("plans")
}

model PlanFeature {
  planId     String   @map("plan_id") @db.Uuid
  featureKey String   @map("feature_key") @db.VarChar(100)
  isEnabled  Boolean  @default(true) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureKey])
  @@map("plan_features")
}

// =========================================================================
// 2. TENANTS & BRANCHES
// =========================================================================

model Institute {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  planId             String?   @map("plan_id") @db.Uuid
  name               String    @db.VarChar(255)
  subdomain          String    @unique @db.VarChar(100)
  logoUrl            String?   @map("logo_url")
  subscriptionStatus String?   @default("ACTIVE") @map("subscription_status") @db.VarChar(50)
  expiryDate         DateTime? @map("expiry_date")
  gracePeriodUntil   DateTime? @map("grace_period_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          String?   @map("deleted_by") @db.Uuid

  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  branches             Branch[]
  academicSessions     AcademicSession[]
  financialYears       FinancialYear[]
  numberSequences      NumberSequence[]
  jobQueueLogs         JobQueueLog[]
  apiKeys              ApiKey[]
  webhookLogs          WebhookLog[]
  exportJobs           ExportJob[]
  users                User[]
  guardians            Guardian[]
  students             Student[]
  drivers              Driver[]
  staffProfiles        StaffProfile[]
  roles                Role[]
  userRoles            UserRole[]
  loginSessions        LoginSession[]
  passwordResetTokens  PasswordResetToken[]
  subscriptions        InstituteSubscription[]
  invoices             SubscriptionInvoice[]
  auditLogs            AuditLog[]
  activities           Activity[]
  mediaFiles           MediaFile[]
  settings             Setting[]
  notifications        Notification[]
  notificationDevices  NotificationDevice[]
  featureFlags         FeatureFlag[]
  aiJobs               AiJob[]

  // Module 02 Relations
  admissionSessions     AdmissionSession[]     @relation("InstituteToAdmissionSessions")
  leads                 Lead[]                 @relation("InstituteToLeads")
  leadFollowups         LeadFollowup[]         @relation("InstituteToLeadFollowups")
  admissionFormTemplates AdmissionFormTemplate[] @relation("InstituteToAdmissionFormTemplates")
  admissionApplications AdmissionApplication[] @relation("InstituteToAdmissionApplications")
  admissionDocuments    AdmissionDocument[]    @relation("InstituteToAdmissionDocuments")
  entranceExams         EntranceExam[]         @relation("InstituteToEntranceExams")
  admissionInterviews   AdmissionInterview[]   @relation("InstituteToAdmissionInterviews")
  classSeats            ClassSeat[]            @relation("InstituteToClassSeats")
  admissionApprovalLogs AdmissionApprovalLog[] @relation("InstituteToAdmissionApprovalLogs")
  ocrAdmissionJobs      OCRAdmissionJob[]      @relation("InstituteToOcrAdmissionJobs")
  feeLedgers            FeeLedger[]            @relation("InstituteToFeeLedgers")
  feeLedgerItems        FeeLedgerItem[]        @relation("InstituteToFeeLedgerItems")

  @@map("institutes")
}

model Branch {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  name        String    @db.VarChar(255)
  address     String?
  phone       String?   @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by") @db.Uuid

  institute     Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  users         User[]
  students      Student[]
  staffProfiles StaffProfile[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  mediaFiles    MediaFile[]
  activities    Activity[]
  aiJobs        AiJob[]
  settings      Setting[]

  // Module 02 Relations
  leads                 Lead[]                 @relation("BranchToLeads")
  admissionApplications AdmissionApplication[] @relation("BranchToAdmissionApplications")
  classSeats            ClassSeat[]            @relation("BranchToClassSeats")

  @@index([instituteId])
  @@map("branches")
}

// =========================================================================
// 3. ACADEMIC, FINANCIAL PERIODS, SEQUENCES & INFRASTRUCTURE
// =========================================================================

model AcademicSession {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  name        String    @db.VarChar(100)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  isActive    Boolean   @default(false) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by") @db.Uuid

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  // Module 02 Relations
  admissionSessions AdmissionSession[] @relation("AcademicSessionToAdmissionSessions")
  classSeats        ClassSeat[]        @relation("AcademicSessionToClassSeats")

  @@index([instituteId])
  @@map("academic_sessions")
}

model FinancialYear {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId String    @map("institute_id") @db.Uuid
  name        String    @db.VarChar(100)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  isActive    Boolean   @default(false) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by") @db.Uuid

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@map("financial_years")
}

model NumberSequence {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId   String   @map("institute_id") @db.Uuid
  sequenceType  String   @map("sequence_type") @db.VarChar(100)
  prefix        String?  @db.VarChar(50)
  currentNumber Int      @default(1) @map("current_number")
  suffix        String?  @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([sequenceType, instituteId], name: "uq_sequence_type_institute")
  @@index([instituteId])
  @@map("number_sequences")
}

model JobQueueLog {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId  String    @map("institute_id") @db.Uuid
  jobType      String    @map("job_type") @db.VarChar(100)
  queueName    String    @map("queue_name") @db.VarChar(100)
  status       String    @default("PENDING") @db.VarChar(50)
  payloadJson  Json?     @map("payload_json")
  resultJson   Json?     @map("result_json")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@map("job_queue_logs")
}

model ApiKey {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId     String    @map("institute_id") @db.Uuid
  name            String    @db.VarChar(255)
  apiKeyHash      String    @unique @map("api_key_hash") @db.VarChar(255)
  permissionsJson Json?     @map("permissions_json")
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime? @map("expires_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@map("api_keys")
}

model WebhookLog {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId  String   @map("institute_id") @db.Uuid
  source       String   @db.VarChar(100)
  eventName    String   @map("event_name") @db.VarChar(100)
  payloadJson  Json?    @map("payload_json")
  status       String   @db.VarChar(50)
  responseCode Int?     @map("response_code")
  receivedAt   DateTime @default(now()) @map("received_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@map("webhook_logs")
}

model ExportJob {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  exportType  String   @map("export_type") @db.VarChar(100)
  fileUrl     String?  @map("file_url")
  requestedBy String   @map("requested_by") @db.Uuid
  status      String   @default("PENDING") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  institute       Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  requestedByUser User      @relation(fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@map("export_jobs")
}

model Country {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String   @db.VarChar(100)
  isoCode      String   @unique @map("iso_code") @db.VarChar(10)
  phoneCode    String?  @map("phone_code") @db.VarChar(10)
  currencyCode String?  @map("currency_code") @db.VarChar(10)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  states State[]
  cities City[]

  @@map("countries")
}

model State {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  name      String   @db.VarChar(100)
  code      String?  @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities  City[]

  @@index([countryId])
  @@map("states")
}

model City {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  stateId   String   @map("state_id") @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  state   State   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([stateId])
  @@index([countryId])
  @@map("cities")
}

// =========================================================================
// 4. IDENTITY AND PROFILE SEPARATION
// =========================================================================

model User {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId  String    @map("institute_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Uuid

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // One-to-One profile extensions
  studentProfile  Student?
  guardianProfile Guardian?
  driverProfile   Driver?
  staffProfile    StaffProfile?

  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  loginSessions       LoginSession[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  mediaFiles          MediaFile[]
  notifications       Notification[]
  notificationDevices NotificationDevice[]
  activities          Activity[]
  exportJobs          ExportJob[]

  // Module 02 Relations
  verifiedDocuments   AdmissionDocument[]    @relation("UserToVerifiedDocuments")
  admissionApprovals  AdmissionApprovalLog[] @relation("UserToAdmissionApprovals")
  ocrReviewedJobs     OCRAdmissionJob[]      @relation("UserToOcrReviewedJobs")
  leadFollowups       LeadFollowup[]         @relation("UserToLeadFollowups")
  feeLedger           FeeLedger?             @relation("UserToFeeLedger")

  @@index([instituteId])
  @@index([branchId])
  @@index([email], map: "idx_users_email")
  @@unique([instituteId, email], map: "uq_user_email_institute")
  @@map("users")
}

model Guardian {
  id                String    @id @db.Uuid
  instituteId       String    @map("institute_id") @db.Uuid
  relationToStudent String?   @map("relation_to_student") @db.VarChar(50)
  occupation        String?   @db.VarChar(150)
  emergencyPhone    String?   @map("emergency_phone") @db.VarChar(50)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by") @db.Uuid

  user      User      @relation(fields: [id], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  students  Student[]

  // Module 02 Relations
  admissionApplications AdmissionApplication[] @relation("GuardianToAdmissionApplications")

  @@map("guardians")
}

model Student {
  id              String    @id @db.Uuid
  instituteId     String    @map("institute_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  rollNumber      String?   @map("roll_number") @db.VarChar(50)
  admissionNumber String    @map("admission_number") @db.VarChar(100)
  className       String?   @map("class_name") @db.VarChar(100)
  sectionName     String?   @map("section_name") @db.VarChar(100)
  guardianId      String?   @map("guardian_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by") @db.Uuid

  user      User      @relation(fields: [id], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  guardian  Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([branchId])
  @@index([guardianId])
  @@index([admissionNumber], map: "idx_students_admission")
  @@unique([instituteId, admissionNumber], map: "uq_student_admission")
  @@map("students")
}

model Driver {
  id            String    @id @db.Uuid
  instituteId   String    @map("institute_id") @db.Uuid
  licenseNumber String    @map("license_number") @db.VarChar(100)
  licenseExpiry DateTime? @map("license_expiry") @db.Date
  vehicleNumber String?   @map("vehicle_number") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by") @db.Uuid

  user      User      @relation(fields: [id], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@map("drivers")
}

model StaffProfile {
  id            String    @id @db.Uuid
  instituteId   String    @map("institute_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  designation   String    @db.VarChar(100)
  department    String?   @db.VarChar(100)
  joiningDate   DateTime? @map("joining_date") @db.Date
  qualification String?
  salary        Decimal?  @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by") @db.Uuid

  user      User      @relation(fields: [id], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([branchId])
  @@map("staff_profiles")
}

// =========================================================================
// 5. ROLES AND PERMISSIONS
// =========================================================================

model Role {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId String?   @map("institute_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by") @db.Uuid

  institute       Institute?       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([name, instituteId], name: "uq_role_name_institute")
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String  @map("user_id") @db.Uuid
  roleId      String  @map("role_id") @db.Uuid
  instituteId String  @map("institute_id") @db.Uuid
  branchId    String? @map("branch_id") @db.Uuid

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

// =========================================================================
// 6. SESSION MANAGEMENT & SECURITY TOKENS
// =========================================================================

model RefreshToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model LoginSession {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @map("token_hash") @db.VarChar(255)
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  deviceInfo  String?  @map("device_info")
  browser     String?  @db.VarChar(100)
  os          String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_sessions")
}

model PasswordResetToken {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime @map("expires_at")
  isUsed      Boolean  @default(false) @map("is_used")
  createdAt   DateTime @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// =========================================================================
// 7. SAAS BILLING SUBSCRIPTIONS
// =========================================================================

model InstituteSubscription {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId  String    @map("institute_id") @db.Uuid
  planId       String?   @map("plan_id") @db.Uuid
  status       String    @db.VarChar(50)
  startDate    DateTime  @map("start_date")
  endDate      DateTime  @map("end_date")
  trialEndsAt  DateTime? @map("trial_ends_at")
  billingCycle String    @map("billing_cycle") @db.VarChar(50)
  amount       Decimal   @db.Decimal(10, 2)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Uuid

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  plan      Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  invoices SubscriptionInvoice[]

  @@index([instituteId])
  @@map("institute_subscriptions")
}

model SubscriptionInvoice {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId    String    @map("institute_id") @db.Uuid
  subscriptionId String?   @map("subscription_id") @db.Uuid
  invoiceNumber  String    @unique @map("invoice_number") @db.VarChar(100)
  amount         Decimal   @db.Decimal(10, 2)

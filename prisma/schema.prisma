model AdmissionApprovalLog {
  id            String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId   String                  @map("institute_id") @db.Uuid
  applicationId String                  @map("application_id") @db.Uuid
  action        AdmissionApprovalAction
  performedBy   String?                 @map("performed_by") @db.Uuid
  comments      String?
  createdAt     DateTime                @default(now()) @map("created_at")

  institute   Institute            @relation("InstituteToAdmissionApprovalLogs", fields: [instituteId], references: [id], onDelete: Cascade)
  application AdmissionApplication @relation("ApplicationToApprovalLogs", fields: [applicationId], references: [id], onDelete: Cascade)
  performer   User?                @relation("UserToAdmissionApprovals", fields: [performedBy], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@map("admission_approval_logs")
}

model OCRAdmissionJob {
  id                String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId       String       @map("institute_id") @db.Uuid
  applicationId     String?      @map("application_id") @db.Uuid
  documentId        String?      @map("document_id") @db.Uuid
  status            OCRJobStatus @default(PENDING)
  extractedDataJson Json?        @map("extracted_data_json")
  errorMessage      String?      @map("error_message")
  confidenceScore   Decimal?     @map("confidence_score") @db.Decimal(5, 2)
  reviewedBy        String?      @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?    @map("reviewed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")

  institute   Institute             @relation("InstituteToOcrAdmissionJobs", fields: [instituteId], references: [id], onDelete: Cascade)
  application AdmissionApplication? @relation("ApplicationToOcrJobs", fields: [applicationId], references: [id], onDelete: Cascade)
  document    AdmissionDocument?    @relation("DocumentToOcrJobs", fields: [documentId], references: [id], onDelete: Cascade)
  reviewer    User?                 @relation("UserToOcrReviewedJobs", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([applicationId])
  // Compound SaaS indexes
  @@index([instituteId, status], map: "idx_ocr_jobs_inst_status")
  @@map("ocr_admission_jobs")
}

model FeeLedger {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId String          @map("institute_id") @db.Uuid
  studentId   String?         @unique @map("student_id") @db.Uuid
  totalDue    Decimal         @default(0.00) @map("total_due") @db.Decimal(12, 2)
  totalPaid   Decimal         @default(0.00) @map("total_paid") @db.Decimal(12, 2)
  balance     Decimal         @default(0.00) @db.Decimal(12, 2)
  status      FeeLedgerStatus @default(CLEARED)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")
  deletedBy   String?         @map("deleted_by") @db.Uuid

  institute Institute @relation("InstituteToFeeLedgers", fields: [instituteId], references: [id], onDelete: Cascade)
  student   User?     @relation("UserToFeeLedger", fields: [studentId], references: [id], onDelete: Cascade)
  items     FeeLedgerItem[] @relation("LedgerToItems")

  @@index([instituteId])
  // Compound indexes
  @@index([instituteId, status], map: "idx_ledgers_inst_status")
  @@map("fee_ledgers")
}

model FeeLedgerItem {
  id          String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  instituteId String              @map("institute_id") @db.Uuid
  ledgerId    String              @map("ledger_id") @db.Uuid
  feeType     AdmissionFeeType    @map("fee_type")
  amount      Decimal             @db.Decimal(12, 2)
  dueDate     DateTime            @map("due_date") @db.Date
  paidAmount  Decimal             @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  status      FeeLedgerItemStatus @default(UNPAID)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")
  deletedBy   String?             @map("deleted_by") @db.Uuid

  institute Institute @relation("InstituteToFeeLedgerItems", fields: [instituteId], references: [id], onDelete: Cascade)
  ledger    FeeLedger @relation("LedgerToItems", fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([ledgerId])
  @@map("fee_ledger_items")
}
